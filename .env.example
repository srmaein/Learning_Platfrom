# Railway PostgreSQL Connection String (automatically supplied by Railway PostgreSQL plugin)
DATABASE_URL=postgresql://postgres:password@containers-us-west-xxx.railway.app:5432/railway

# PostgreSQL Individual Connection Parameters (Fallback)
PGHOST=localhost
PGPORT=5432
PGDATABASE=online_education
PGUSER=postgres
PGPASSWORD=postgres

# Application Settings
APP_ENV=production
APP_URL=https://your-railway-app.up.railway.app

# Security & Initial Admin Setup
SESSION_SECRET=a_random_32_character_secret_key_here
ADMIN_SETUP_KEY=RailwayAdminSetup2026

# Payment Gateway Configuration
PAYMENT_PROVIDER=SSLCommerz
PAYMENT_STORE_ID=your_store_id
PAYMENT_STORE_PASSWORD=your_store_password
PAYMENT_API_KEY=your_api_key
PAYMENT_SANDBOX=true
