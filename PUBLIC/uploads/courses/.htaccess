# Disable script execution in uploads directory for security
<FilesMatch "\.(php|phtml|php3|php4|php5|phps|pl|py|jsp|asp|htm|html|shtml|sh|cgi)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Turn off PHP engine if mod_php is used
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
